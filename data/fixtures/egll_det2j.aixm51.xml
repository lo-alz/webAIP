            <aixm:Point gml:id="P_BIG"><gml:pos>51.33083300 0.03472200</gml:pos></aixm:Point>
          </aixm:location>
        </aixm:DesignatedPointTimeSlice>
      </aixm:timeSlice>
    </aixm:DesignatedPoint>
  </aixm:hasMember>

  <aixm:hasMember>
