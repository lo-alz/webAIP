<?xml version="1.0" encoding="UTF-8"?>
<!--
  AeroAIP fixture — representative AIXM 5.1 subset for the EGLL DET2J RNAV SID,
  standing in for an EUROCONTROL EAD AIXM 5.1 export (the UK/EGLL is a Phase-0
  test airport; access via EAD Basic, free registration). The aixm:DesignatedPoint
  features carry REAL gml:pos geometry (the part coordinates depend on); the leg
  encoding is the compact form miner/extractor/aixm_upconverter.py reads. Used by
  scripts/poc_egll_eaip.py and tests/test_aixm_upconvert.py.
-->
<aixm:AIXMBasicMessage
    xmlns:aixm="http://www.aixm.aero/schema/5.1"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:xlink="http://www.w3.org/1999/xlink">

  <aixm:hasMember>
    <aixm:DesignatedPoint gml:id="WP_OCK">
      <aixm:timeSlice>
        <aixm:DesignatedPointTimeSlice gml:id="WPTS_OCK">
          <aixm:designator>OCK</aixm:designator>
          <aixm:icaoRegion>EG</aixm:icaoRegion>
          <aixm:location>
            <aixm:Point gml:id="P_OCK"><gml:pos>51.30527800 -0.44722200</gml:pos></aixm:Point>
          </aixm:location>
        </aixm:DesignatedPointTimeSlice>
      </aixm:timeSlice>
    </aixm:DesignatedPoint>
  </aixm:hasMember>

  <aixm:hasMember>
    <aixm:DesignatedPoint gml:id="WP_BIG">
