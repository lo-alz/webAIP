    </aixm:DesignatedPoint>
  </aixm:hasMember>

  <aixm:hasMember>
    <aixm:StandardInstrumentDeparture gml:id="SID_DET2J">
      <aixm:timeSlice>
        <aixm:StandardInstrumentDepartureTimeSlice gml:id="SIDTS_DET2J">
          <aixm:designator>DET2J</aixm:designator>
          <aixm:airportICAO>EGLL</aixm:airportICAO>
          <aixm:pbnRequirement>D1</aixm:pbnRequirement>
          <aixm:transition kind="runway" designator="09R" id="DET2J.09R">
            <aixm:leg seq="10" pathTerminator="VA" courseMag="91.0" altType="AT_OR_ABOVE" altFt="1080"/>
            <aixm:leg seq="20" pathTerminator="DF" point="OCK" flyOver="false" altType="AT_OR_BELOW" altFt="3000"/>
            <aixm:leg seq="30" pathTerminator="TF" point="BIG" flyOver="false"/>
            <aixm:leg seq="40" pathTerminator="TF" point="DET" flyOver="false" altType="AT_OR_ABOVE" altFt="5000" spdType="AT_OR_BELOW" spdKt="250"/>
          </aixm:transition>
