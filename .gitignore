# Downloaded authoritative data (large, regenerated per AIRAC cycle)
data/nasr/*
data/ead/*
data/navcanada/*
!data/nasr/.gitkeep
!data/ead/.gitkeep
!data/navcanada/.gitkeep

# Generated SQLite waypoint index (built from sources / fixtures)
data/waypoints/*.db

# OurAirports raw CSV downloads + large per-airport scan output (regenerable)
data/ourairports/
data/airports.json

# Committed fixtures are NOT ignored (data/fixtures/** is tracked)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets
.env

# Editor / OS
.DS_Store
.idea/
.vscode/
